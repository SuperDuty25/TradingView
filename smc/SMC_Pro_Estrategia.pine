//@version=6
strategy("SMC Pro · Estrategia (OB HTF + CHoCH)", shorttitle = "SMC Pro Estrategia", overlay = true, initial_capital = 200, currency = currency.USD, default_qty_type = strategy.fixed, default_qty_value = 1, commission_type = strategy.commission.percent, commission_value = 0.05, slippage = 2, pyramiding = 0, margin_long = 10, margin_short = 10, process_orders_on_close = false, calc_on_every_tick = false, max_bars_back = 500, max_boxes_count = 50, max_lines_count = 100, max_labels_count = 100)

// =====================================================================
// SMC Pro (estrategia para backtest). MISMO motor y MISMAS reglas que el indicador.
// 1) Sesgo y OB en la TF superior (4H): el OB debe haber tomado liquidez y dejado FVG.
//    Se vigilan hasta 3 OB activos por dirección.
// 2) El precio toca el 50% de un OB sin cerrar al otro lado → setup ARMADO.
//    Filtros opcionales: premium/discount u OTE, y killzones.
// 3) CHoCH a favor en el gráfico (15m) en ≤ N velas → ENTRADA a mercado.
// 4) SL detrás del OB (+ margen ATR). TP: 3R, siguiente liquidez o el más conservador.
//    Break-even opcional al llegar a 1R.
// 5) Tamaño por riesgo fijo (% del capital), limitado por el apalancamiento.
// 6) Cierre forzado si la operación supera la duración máxima (48 h por defecto).
// margin_long/short = 10 → el broker simulado permite hasta x10.
// =====================================================================

// ---------------------------------------------------------------------
// 1. ENTRADAS COMUNES (idénticas en indicador y estrategia)
// ---------------------------------------------------------------------
const string G_HTF = "Temporalidad superior (sesgo y OB)"
const string G_EST = "Estructura (gráfico)"
const string G_OB  = "Order Blocks"
const string G_PD  = "Premium / Discount y OTE"
const string G_KZ  = "Killzones (sesiones)"
const string G_SET = "Modelo de entrada"
const string G_RSK = "Gestión de riesgo"
const string G_OPP = "Panel ¿Hay oportunidad?"

showOpp    = input.bool(true, "Mostrar panel ¿Hay oportunidad?", group = G_OPP)
oppPosTxt  = input.string("Arriba derecha", "Posición del panel", options = ["Arriba derecha", "Arriba izquierda", "Abajo derecha", "Abajo izquierda"], group = G_OPP)
oppTamTxt  = input.string("Normal", "Tamaño del texto", options = ["Pequeño", "Normal", "Grande"], group = G_OPP)

htfTf      = input.timeframe("240", "Temporalidad superior", group = G_HTF)
htfLen     = input.int(5, "Longitud de pivote TF superior", minval = 2, maxval = 50, group = G_HTF, tooltip = "Velas a cada lado para confirmar un swing en la TF superior. En 4H, 5 = el swing se confirma 20 horas después.")
nSlots     = input.int(3, "OB activos de la TF superior por dirección", minval = 1, maxval = 3, group = G_HTF, tooltip = "Cuántos OB válidos (no mitigados) se vigilan a la vez, empezando por el más reciente.")

intLen     = input.int(5, "Longitud de pivote (estructura interna)", minval = 2, maxval = 50, group = G_EST, tooltip = "Velas a cada lado para confirmar un swing en el gráfico. En 15m, 5 = el swing se confirma 75 minutos después.")

reqSweep   = input.bool(true, "Exigir toma de liquidez previa", group = G_OB)
reqFvg     = input.bool(true, "Exigir FVG en el desplazamiento", group = G_OB)
scanMax    = input.int(100, "Velas máximas a escanear para buscar el OB", minval = 10, maxval = 300, group = G_OB)
eqTol      = input.float(0.1, "Tolerancia EQH / EQL (× ATR 14)", minval = 0.01, step = 0.01, group = G_OB)

modoZona   = input.string("Ninguno", "Filtro de zona del OB", options = ["Ninguno", "Premium/Discount", "OTE (62–79%)"], group = G_PD, tooltip = "Rango = máximo y mínimo del último tramo de la TF superior.\nPremium/Discount: el 50% del OB alcista debe estar por debajo del equilibrio (y el bajista por encima).\nOTE: el 50% del OB debe estar en el retroceso 62–79% del rango.")

usarKZ     = input.bool(false, "Entrar solo dentro de killzones", group = G_KZ)
kzTz       = input.string("America/New_York", "Zona horaria de las sesiones", group = G_KZ)
kzLonOn    = input.bool(true, "Londres", inline = "lon", group = G_KZ)
kzLon      = input.session("0200-0500", "", inline = "lon", group = G_KZ)
kzNyOn     = input.bool(true, "Nueva York", inline = "ny", group = G_KZ)
kzNy       = input.session("0700-1000", "", inline = "ny", group = G_KZ)
kzAsiaOn   = input.bool(false, "Asia", inline = "as", group = G_KZ)
kzAsia     = input.session("2000-2359", "", inline = "as", group = G_KZ)

usarSesgo  = input.bool(true, "Operar solo a favor del sesgo de la TF superior", group = G_SET)
soloChoch  = input.bool(true, "Confirmación solo con CHoCH (si no, también BOS)", group = G_SET)
maxEspera  = input.int(48, "Velas máximas entre toque del 50% y confirmación", minval = 1, group = G_SET, tooltip = "En 15m, 48 velas = 12 horas.")

slBuf      = input.float(0.2, "Margen del stop detrás del OB (× ATR 14)", minval = 0.0, step = 0.05, group = G_RSK)
rr         = input.float(3.0, "Relación R:B objetivo", minval = 1.0, step = 0.5, group = G_RSK)
minRR      = input.float(2.0, "R:B mínimo para aceptar la operación", minval = 0.5, step = 0.5, group = G_RSK)
modoTP     = input.string("Más conservador", "Objetivo (TP)", options = ["3R fijo", "Siguiente liquidez", "Más conservador"], group = G_RSK, tooltip = "3R fijo: TP = entrada + R × riesgo.\nSiguiente liquidez: el swing no tomado más cercano que cumpla el R:B mínimo (si no hay, usa 3R).\nMás conservador: el más cercano entre 3R y esa liquidez.")
apal       = input.int(5, "Apalancamiento máximo", minval = 1, maxval = 10, group = G_RSK)
usarBE     = input.bool(false, "Mover stop a break-even", group = G_RSK)
beR        = input.float(1.0, "Activar break-even al llegar a (R)", minval = 0.5, step = 0.25, group = G_RSK)
beOff      = input.float(0.0, "Colchón del break-even (× riesgo)", minval = 0.0, step = 0.05, group = G_RSK, tooltip = "0 = stop exactamente en la entrada. Un pequeño colchón (p. ej. 0,1) cubre comisiones.")
maxHoras   = input.int(48, "Duración máxima de la operación (horas)", minval = 1, group = G_RSK)

// ---------------------------------------------------------------------
// 1b. ENTRADAS DE BACKTEST (solo estrategia)
// ---------------------------------------------------------------------
dirOp      = input.string("Ambas", "Dirección", options = ["Ambas", "Solo largos", "Solo cortos"], group = G_SET)
riesgoPct  = input.float(1.0, "Riesgo por operación (% del capital)", minval = 0.1, maxval = 10, step = 0.1, group = G_RSK)
enteras    = input.bool(false, "Cantidad en unidades enteras (acciones)", group = G_RSK)
desde      = input.time(timestamp("2024-01-01T00:00:00"), "Backtest desde", group = G_RSK)

colBull    = input.color(#14532D, "OB alcista TF superior", group = "Colores")
colBear    = input.color(#5B1A1A, "OB bajista TF superior", group = "Colores")
colTxt     = input.color(#B2B5BE, "Texto / 50%", group = "Colores")

// ---------------------------------------------------------------------
// 2. MOTOR SMC (estructura, liquidez, Order Blocks y rango)
//    Se usa en el gráfico y dentro de request.security para la TF superior.
// ---------------------------------------------------------------------
f_smc(simple int len, bool needSweep, bool needFvg, simple int maxScan, float tol, array<float> hP, array<int> hI, array<float> lP, array<int> lI, array<float> aBT, array<float> aBB, array<int> aBTm, array<float> aST, array<float> aSB, array<int> aSTm) =>
    var int   trend   = 0
    var float swHi    = na
    var int   swHiIdx = na
    var bool  swHiOn  = false
    var float swLo    = na
    var int   swLoIdx = na
    var bool  swLoOn  = false
    var int   bslIdx  = na
    var int   sslIdx  = na
    var float trTop   = na
    var float trBot   = na

    float atr = ta.atr(14)
    float ph  = ta.pivothigh(high, len, len)
    float pl  = ta.pivotlow(low, len, len)

    int   evt     = 0
    float evtLvl  = na
    int   evtFrom = na
    bool  nBull   = false
    float nBT     = na
    float nBB     = na
    int   nBIdx   = na
    bool  nBear   = false
    float nST     = na
    float nSB     = na
    int   nSIdx   = na
    bool  bslSw   = false
    float bslLvl  = na
    int   bslFrom = na
    bool  sslSw   = false
    float sslLvl  = na
    int   sslFrom = na
    float eqhLvl  = na
    int   eqhFrom = na
    float eqlLvl  = na
    int   eqlFrom = na

    // --- Liquidez tomada: swings no tomados que el precio supera ---
    int nH = array.size(hP)
    if nH > 0
        for k = nH - 1 to 0
            float p = array.get(hP, k)
            if high > p
                bslIdx := bar_index
                if na(bslLvl) or p > bslLvl
                    bslLvl  := p
                    bslFrom := array.get(hI, k)
                array.remove(hP, k)
                array.remove(hI, k)
    // Barrido = la mecha toma el nivel pero la vela cierra de vuelta
    bslSw := not na(bslLvl) and close < bslLvl

    int nL = array.size(lP)
    if nL > 0
        for k = nL - 1 to 0
            float p = array.get(lP, k)
            if low < p
                sslIdx := bar_index
                if na(sslLvl) or p < sslLvl
                    sslLvl  := p
                    sslFrom := array.get(lI, k)
                array.remove(lP, k)
                array.remove(lI, k)
    sslSw := not na(sslLvl) and close > sslLvl

    // --- Nuevos swings confirmados → pools de liquidez + EQH / EQL ---
    if not na(ph)
        int pIdx = bar_index - len
        int n = array.size(hP)
        if n > 0
            for k = 0 to n - 1
                if math.abs(ph - array.get(hP, k)) <= atr * tol
                    eqhLvl  := ph
                    eqhFrom := array.get(hI, k)
        array.push(hP, ph)
        array.push(hI, pIdx)
        if array.size(hP) > 40
            array.shift(hP)
            array.shift(hI)
        swHi    := ph
        swHiIdx := pIdx
        swHiOn  := true
        trTop   := ph

    if not na(pl)
        int pIdx = bar_index - len
        int n = array.size(lP)
        if n > 0
            for k = 0 to n - 1
                if math.abs(pl - array.get(lP, k)) <= atr * tol
                    eqlLvl  := pl
                    eqlFrom := array.get(lI, k)
        array.push(lP, pl)
        array.push(lI, pIdx)
        if array.size(lP) > 40
            array.shift(lP)
            array.shift(lI)
        swLo    := pl
        swLoIdx := pIdx
        swLoOn  := true
        trBot   := pl

    // Rango del tramo actual (extremos desde el último swing): base de premium/discount
    trTop := na(trTop) ? high : math.max(trTop, high)
    trBot := na(trBot) ? low : math.min(trBot, low)

    // --- Mitigación de los OB activos: cierre al otro lado ---
    int nb = array.size(aBT)
    if nb > 0
        for k = nb - 1 to 0
            if close < array.get(aBB, k)
                array.remove(aBT, k)
                array.remove(aBB, k)
                array.remove(aBTm, k)
    int ns = array.size(aST)
    if ns > 0
        for k = ns - 1 to 0
            if close > array.get(aST, k)
                array.remove(aST, k)
                array.remove(aSB, k)
                array.remove(aSTm, k)

    // --- Ruptura alcista (BOS / CHoCH) por cierre ---
    if swHiOn and close > swHi
        evt     := trend < 0 ? 2 : 1
        evtLvl  := swHi
        evtFrom := swHiIdx
        trend   := 1
        swHiOn  := false
        int   span = math.min(bar_index - swHiIdx, maxScan)
        float cT   = na
        float cB   = na
        int   cOff = na
        // Última vela bajista del tramo (la de mínimo más bajo = origen del impulso)
        for i = 1 to span
            if close[i] < open[i] and (na(cB) or low[i] < cB)
                cB   := low[i]
                cT   := high[i]
                cOff := i
        if not na(cOff)
            bool fvgOk = false
            if cOff >= 2
                for j = 0 to cOff - 2
                    if low[j] > high[j + 2]
                        fvgOk := true
                        break
            bool sweepOk = not na(sslIdx) and sslIdx >= swHiIdx
            if (not needFvg or fvgOk) and (not needSweep or sweepOk)
                nBull := true
                nBT   := cT
                nBB   := cB
                nBIdx := bar_index - cOff
                array.unshift(aBT, cT)
                array.unshift(aBB, cB)
                array.unshift(aBTm, time[cOff])
                if array.size(aBT) > 10
                    array.pop(aBT)
                    array.pop(aBB)
                    array.pop(aBTm)

    // --- Ruptura bajista (BOS / CHoCH) por cierre ---
    if swLoOn and close < swLo
        evt     := trend > 0 ? -2 : -1
        evtLvl  := swLo
        evtFrom := swLoIdx
        trend   := -1
        swLoOn  := false
        int   span = math.min(bar_index - swLoIdx, maxScan)
        float cT   = na
        float cB   = na
        int   cOff = na
        for i = 1 to span
            if close[i] > open[i] and (na(cT) or high[i] > cT)
                cT   := high[i]
                cB   := low[i]
                cOff := i
        if not na(cOff)
            bool fvgOk = false
            if cOff >= 2
                for j = 0 to cOff - 2
                    if high[j] < low[j + 2]
                        fvgOk := true
                        break
            bool sweepOk = not na(bslIdx) and bslIdx >= swLoIdx
            if (not needFvg or fvgOk) and (not needSweep or sweepOk)
                nBear := true
                nST   := cT
                nSB   := cB
                nSIdx := bar_index - cOff
                array.unshift(aST, cT)
                array.unshift(aSB, cB)
                array.unshift(aSTm, time[cOff])
                if array.size(aST) > 10
                    array.pop(aST)
                    array.pop(aSB)
                    array.pop(aSTm)

    [trend, evt, evtLvl, evtFrom, nBull, nBT, nBB, nBIdx, nBear, nST, nSB, nSIdx, bslSw, bslLvl, bslFrom, sslSw, sslLvl, sslFrom, eqhLvl, eqhFrom, eqlLvl, eqlFrom, atr, trTop, trBot]

f_getF(array<float> a, int k) =>
    array.size(a) > k ? array.get(a, k) : na

f_getI(array<int> a, int k) =>
    array.size(a) > k ? array.get(a, k) : na

// Envoltorio para la TF superior: devuelve la vela HTF ya CERRADA (sin repintado)
f_htf(simple int len, bool needSweep, bool needFvg, simple int maxScan, float tol) =>
    var array<float> hp = array.new<float>()
    var array<int>   hx = array.new<int>()
    var array<float> lp = array.new<float>()
    var array<int>   lx = array.new<int>()
    var array<float> bt = array.new<float>()
    var array<float> bb = array.new<float>()
    var array<int>   bm = array.new<int>()
    var array<float> st = array.new<float>()
    var array<float> sb = array.new<float>()
    var array<int>   sm = array.new<int>()
    [t, e1, e2, e3, e4, e5, e6, e7, e8, e9, e10, e11, e12, e13, e14, e15, e16, e17, e18, e19, e20, e21, a, tt, tb] = f_smc(len, needSweep, needFvg, maxScan, tol, hp, hx, lp, lx, bt, bb, bm, st, sb, sm)
    float b1T = f_getF(bt, 0)
    float b1B = f_getF(bb, 0)
    int   b1M = f_getI(bm, 0)
    float b2T = f_getF(bt, 1)
    float b2B = f_getF(bb, 1)
    int   b2M = f_getI(bm, 1)
    float b3T = f_getF(bt, 2)
    float b3B = f_getF(bb, 2)
    int   b3M = f_getI(bm, 2)
    float s1T = f_getF(st, 0)
    float s1B = f_getF(sb, 0)
    int   s1M = f_getI(sm, 0)
    float s2T = f_getF(st, 1)
    float s2B = f_getF(sb, 1)
    int   s2M = f_getI(sm, 1)
    float s3T = f_getF(st, 2)
    float s3B = f_getF(sb, 2)
    int   s3M = f_getI(sm, 2)
    [t[1], tt[1], tb[1], b1T[1], b1B[1], b1M[1], b2T[1], b2B[1], b2M[1], b3T[1], b3B[1], b3M[1], s1T[1], s1B[1], s1M[1], s2T[1], s2B[1], s2M[1], s3T[1], s3B[1], s3M[1]]

// Liquidez objetivo: swing no tomado más cercano más allá de un umbral
f_liq(array<float> pool, float thr, bool up) =>
    float best = na
    int n = array.size(pool)
    if n > 0 and not na(thr)
        for k = 0 to n - 1
            float p = array.get(pool, k)
            if up and p >= thr and (na(best) or p < best)
                best := p
            if not up and p <= thr and (na(best) or p > best)
                best := p
    best

// Filtro premium/discount u OTE sobre el 50% del OB
f_zonaOk(float m, bool up, string modo, float top, float bot) =>
    float rng = top - bot
    bool ok = true
    if modo == "Premium/Discount"
        ok := not na(rng) and rng > 0 and (up ? m < bot + rng * 0.5 : m > bot + rng * 0.5)
    else if modo == "OTE (62–79%)"
        ok := not na(rng) and rng > 0 and (up ? (m <= top - rng * 0.62 and m >= top - rng * 0.79) : (m >= bot + rng * 0.62 and m <= bot + rng * 0.79))
    ok

// Elige el OB más reciente cuyo 50% se toca en esta vela (sin cerrar al otro lado)
f_pick(array<float> tops, array<float> bots, array<int> tms, array<int> used, bool up, int nS, string modo, float top, float bot) =>
    float rt  = na
    float rb  = na
    int   rtm = na
    for k = 0 to nS - 1
        float t  = array.get(tops, k)
        float b  = array.get(bots, k)
        int   tm = array.get(tms, k)
        if na(rtm) and not na(tm) and not array.includes(used, tm)
            float m = (t + b) / 2
            bool touch = up ? (low <= m and close >= b) : (high >= m and close <= t)
            if touch and f_zonaOk(m, up, modo, top, bot)
                rt  := t
                rb  := b
                rtm := tm
    [rt, rb, rtm]

f_inSes(string ses, string tz) =>
    not na(time(timeframe.period, ses, tz))

f_trendTxt(int t) =>
    t == 1 ? "Alcista ▲" : t == -1 ? "Bajista ▼" : "Neutral"

bool plano = strategy.position_size == 0

// ---------------------------------------------------------------------
// 3. CÁLCULOS (idénticos en indicador y estrategia)
// ---------------------------------------------------------------------
var array<float> lqHiP = array.new<float>()
var array<int>   lqHiI = array.new<int>()
var array<float> lqLoP = array.new<float>()
var array<int>   lqLoI = array.new<int>()
var array<float> loBT  = array.new<float>()
var array<float> loBB  = array.new<float>()
var array<int>   loBTm = array.new<int>()
var array<float> loST  = array.new<float>()
var array<float> loSB  = array.new<float>()
var array<int>   loSTm = array.new<int>()

[trend, evt, evtLvl, evtFrom, nBull, nBT, nBB, nBIdx, nBear, nST, nSB, nSIdx, bslSw, bslLvl, bslFrom, sslSw, sslLvl, sslFrom, eqhLvl, eqhFrom, eqlLvl, eqlFrom, atrL, trTopL, trBotL] = f_smc(intLen, reqSweep, reqFvg, scanMax, eqTol, lqHiP, lqHiI, lqLoP, lqLoI, loBT, loBB, loBTm, loST, loSB, loSTm)

[hTrend, hTop, hBot, hB1T, hB1B, hB1M, hB2T, hB2B, hB2M, hB3T, hB3B, hB3M, hS1T, hS1B, hS1M, hS2T, hS2B, hS2M, hS3T, hS3B, hS3M] = request.security(syminfo.tickerid, htfTf, f_htf(htfLen, reqSweep, reqFvg, scanMax, eqTol), lookahead = barmerge.lookahead_on)

array<float> hBTs = array.from(hB1T, hB2T, hB3T)
array<float> hBBs = array.from(hB1B, hB2B, hB3B)
array<int>   hBMs = array.from(hB1M, hB2M, hB3M)
array<float> hSTs = array.from(hS1T, hS2T, hS3T)
array<float> hSBs = array.from(hS1B, hS2B, hS3B)
array<int>   hSMs = array.from(hS1M, hS2M, hS3M)

bool tfOk = timeframe.in_seconds() < timeframe.in_seconds(htfTf)

// Killzones
bool inLon  = f_inSes(kzLon, kzTz)
bool inNy   = f_inSes(kzNy, kzTz)
bool inAsia = f_inSes(kzAsia, kzTz)
bool inKZ   = (kzLonOn and inLon) or (kzNyOn and inNy) or (kzAsiaOn and inAsia)
bool kzOk   = not usarKZ or inKZ

// ---------------------------------------------------------------------
// 4. MODELO DE ENTRADA
//    1) El precio toca el 50% de un OB activo de la TF superior sin cerrar al otro lado → ARMADO
//    2) En ≤ maxEspera velas aparece CHoCH a favor en el gráfico → SEÑAL
//    3) SL detrás del OB (+ margen ATR); TP según modo; filtros R:B, liquidación, zona y killzone
// ---------------------------------------------------------------------
var bool  armL    = false
var int   armLBar = na
var float armLT   = na
var float armLB   = na
var int   armLM   = na
var bool  armS    = false
var int   armSBar = na
var float armST   = na
var float armSB   = na
var int   armSM   = na
var array<int> usadosL = array.new<int>()
var array<int> usadosS = array.new<int>()

if armL and (close < armLB or bar_index - armLBar > maxEspera)
    armL := false
if armS and (close > armST or bar_index - armSBar > maxEspera)
    armS := false

[pLT, pLB, pLM] = f_pick(hBTs, hBBs, hBMs, usadosL, true, nSlots, modoZona, hTop, hBot)
[pST, pSB, pSM] = f_pick(hSTs, hSBs, hSMs, usadosS, false, nSlots, modoZona, hTop, hBot)
bool toqueL = not na(pLM)
bool toqueS = not na(pSM)

if not armL and toqueL
    armL    := true
    armLBar := bar_index
    armLT   := pLT
    armLB   := pLB
    armLM   := pLM
if not armS and toqueS
    armS    := true
    armSBar := bar_index
    armST   := pST
    armSB   := pSB
    armSM   := pSM

bool confL  = soloChoch ? evt == 2 : evt > 0
bool confS  = soloChoch ? evt == -2 : evt < 0
bool sesgoL = not usarSesgo or hTrend == 1
bool sesgoS = not usarSesgo or hTrend == -1

float slL   = armLB - atrL * slBuf
float riskL = close - slL
float tpL3  = close + rr * riskL
float liqL  = f_liq(lqHiP, close + minRR * riskL, true)
float tpL   = modoTP == "3R fijo" ? tpL3 : na(liqL) ? tpL3 : modoTP == "Siguiente liquidez" ? liqL : math.min(tpL3, liqL)

float slS   = armST + atrL * slBuf
float riskS = slS - close
float tpS3  = close - rr * riskS
float liqS  = f_liq(lqLoP, close - minRR * riskS, false)
float tpS   = modoTP == "3R fijo" ? tpS3 : na(liqS) ? tpS3 : modoTP == "Siguiente liquidez" ? liqS : math.max(tpS3, liqS)

// Filtro de liquidación (aproximado): el stop debe quedar antes del 80% de la distancia de liquidación
float liqDist = 100.0 / apal * 0.8
bool okL = riskL > 0 and (tpL - close) / riskL >= minRR and riskL / close * 100 < liqDist
bool okS = riskS > 0 and (close - tpS) / riskS >= minRR and riskS / close * 100 < liqDist

bool senalL = tfOk and plano and armL and confL and sesgoL and okL and kzOk
bool senalS = tfOk and plano and armS and confS and sesgoS and okS and kzOk and not senalL

if senalL
    array.push(usadosL, armLM)
    if array.size(usadosL) > 100
        array.shift(usadosL)
    armL := false
if senalS
    array.push(usadosS, armSM)
    if array.size(usadosS) > 100
        array.shift(usadosS)
    armS := false

// ---------------------------------------------------------------------
// 5. ÓRDENES
// ---------------------------------------------------------------------
bool enRango = time >= desde

f_qty(float risk) =>
    float q = strategy.equity * riesgoPct / 100 / risk
    q := math.min(q, strategy.equity * apal / close)
    enteras ? float(math.floor(q)) : q

var float pSL   = na
var float pTP   = na
var float pRisk = na
var bool  pBE   = false

if enRango and senalL and dirOp != "Solo cortos"
    float q = f_qty(riskL)
    if q > 0
        strategy.entry("Largo", strategy.long, qty = q)
        strategy.exit("Salida L", from_entry = "Largo", stop = slL, limit = tpL, comment_loss = "SL", comment_profit = "TP")
        pSL   := slL
        pTP   := tpL
        pRisk := riskL
        pBE   := false

if enRango and senalS and dirOp != "Solo largos"
    float q = f_qty(riskS)
    if q > 0
        strategy.entry("Corto", strategy.short, qty = q)
        strategy.exit("Salida C", from_entry = "Corto", stop = slS, limit = tpS, comment_loss = "SL", comment_profit = "TP")
        pSL   := slS
        pTP   := tpS
        pRisk := riskS
        pBE   := false

// Break-even: al alcanzar beR × riesgo, el stop pasa a la entrada (+ colchón)
if usarBE and not pBE and strategy.position_size != 0
    float ep = strategy.position_avg_price
    if strategy.position_size > 0 and high >= ep + beR * pRisk
        pBE := true
        pSL := ep + beOff * pRisk
        strategy.exit("Salida L", from_entry = "Largo", stop = ep + beOff * pRisk, limit = pTP, comment_loss = "BE", comment_profit = "TP")
    if strategy.position_size < 0 and low <= ep - beR * pRisk
        pBE := true
        pSL := ep - beOff * pRisk
        strategy.exit("Salida C", from_entry = "Corto", stop = ep - beOff * pRisk, limit = pTP, comment_loss = "BE", comment_profit = "TP")

// Cierre por tiempo máximo
if strategy.position_size != 0
    int t0 = strategy.opentrades.entry_time(strategy.opentrades - 1)
    if time - t0 >= maxHoras * 3600000
        strategy.close_all(comment = "Tiempo máx.")

// ---------------------------------------------------------------------
// 6. VISUAL MÍNIMO (OB más reciente de cada lado y setups armados)
// ---------------------------------------------------------------------
plot(hB1T, "OB alcista techo", color = colBull, style = plot.style_linebr, linewidth = 2)
plot(hB1B, "OB alcista base", color = colBull, style = plot.style_linebr, linewidth = 2)
plot((hB1T + hB1B) / 2, "OB alcista 50%", color = colTxt, style = plot.style_linebr)
plot(hS1T, "OB bajista techo", color = colBear, style = plot.style_linebr, linewidth = 2)
plot(hS1B, "OB bajista base", color = colBear, style = plot.style_linebr, linewidth = 2)
plot((hS1T + hS1B) / 2, "OB bajista 50%", color = colTxt, style = plot.style_linebr)
plotshape(armL, "Armado largo", shape.circle, location.belowbar, color.new(colBull, 40), size = size.tiny)
plotshape(armS, "Armado corto", shape.circle, location.abovebar, color.new(colBear, 40), size = size.tiny)

// Estado de la posición para el panel de oportunidad
int   posDir = strategy.position_size > 0 ? 1 : strategy.position_size < 0 ? -1 : 0
float posEnt = strategy.position_avg_price
float posSL  = pSL
float posTP  = pTP
bool  posBE  = pBE

// ---------------------------------------------------------------------
// 11. PANEL "¿HAY OPORTUNIDAD?" (lenguaje sencillo)
// ---------------------------------------------------------------------
color cOppVerde = #1F7A63
color cOppRojo  = #8E2F3C
color cOppAmbar = #7A5E1A
color cOppGris  = #2A2E39
color cOppFondo = #131722
color cOppTexto = #D1D4DC

// Zona de compra (o venta) válida más cercana al precio actual
f_cercana(array<float> tops, array<float> bots, array<int> tms, int nS, bool up) =>
    float rt = na
    float rb = na
    for k = 0 to nS - 1
        float t  = array.get(tops, k)
        float b  = array.get(bots, k)
        int   tm = array.get(tms, k)
        if not na(tm)
            if up and b <= close and (na(rt) or t > rt)
                rt := t
                rb := b
            if not up and t >= close and (na(rb) or b < rb)
                rt := t
                rb := b
    [rt, rb]

f_px(float v) =>
    na(v) ? "—" : str.tostring(v, format.mintick)

[zcT, zcB] = f_cercana(hBTs, hBBs, hBMs, nSlots, true)
[zvT, zvB] = f_cercana(hSTs, hSBs, hSMs, nSlots, false)

// Avisos: confirmaciones que aparecieron pero se descartaron (se muestran 8 velas)
var string aviso    = ""
var int    avisoBar = na
if armL and confL and sesgoL and not senalL
    aviso    := not plano ? "Hubo confirmación de LONG, pero ya hay una operación abierta." : not kzOk ? "Hubo confirmación de LONG fuera del horario elegido: descartada." : "Hubo confirmación de LONG, pero el beneficio posible es pequeño para el riesgo (o el stop queda muy lejos): descartada."
    avisoBar := bar_index
if armS and confS and sesgoS and not senalS
    aviso    := not plano ? "Hubo confirmación de SHORT, pero ya hay una operación abierta." : not kzOk ? "Hubo confirmación de SHORT fuera del horario elegido: descartada." : "Hubo confirmación de SHORT, pero el beneficio posible es pequeño para el riesgo (o el stop queda muy lejos): descartada."
    avisoBar := bar_index

string oppPos = oppPosTxt == "Arriba izquierda" ? position.top_left : oppPosTxt == "Abajo derecha" ? position.bottom_right : oppPosTxt == "Abajo izquierda" ? position.bottom_left : position.top_right
string oppTam = oppTamTxt == "Pequeño" ? size.small : oppTamTxt == "Grande" ? size.large : size.normal

var table opp = table.new(oppPos, 2, 10, bgcolor = cOppFondo, border_color = cOppGris, border_width = 1, frame_color = cOppGris, frame_width = 2)

if showOpp and barstate.islast
    string htfN  = htfTf == "240" ? "4H" : htfTf
    string nota  = barstate.isconfirmed ? "" : "\n(Espera al cierre de la vela para confirmar)"
    string est   = ""
    string que   = ""
    color  cEst  = cOppGris
    float  vE    = na
    float  vS    = na
    float  vT    = na
    if not tfOk
        est  := "⚠ CAMBIA EL GRÁFICO"
        que  := "Pon el gráfico en 15 minutos (debe ser menor que " + htfN + ")."
        cEst := cOppAmbar
    else if senalL
        est  := "🟢 ABRIR LONG (COMPRA)"
        que  := "Compra ahora y coloca el Stop y el Objetivo de abajo." + nota
        cEst := cOppVerde
        vE   := close
        vS   := slL
        vT   := tpL
    else if senalS
        est  := "🔴 ABRIR SHORT (VENTA)"
        que  := "Vende ahora y coloca el Stop y el Objetivo de abajo." + nota
        cEst := cOppRojo
        vE   := close
        vS   := slS
        vT   := tpS
    else if posDir == 1
        est  := "📈 LONG ABIERTO"
        que  := posBE ? "El stop ya está en la entrada (sin riesgo). Deja correr hasta el objetivo." : "Mantén la operación. No muevas el Stop ni el Objetivo."
        cEst := cOppVerde
        vE   := posEnt
        vS   := posSL
        vT   := posTP
    else if posDir == -1
        est  := "📉 SHORT ABIERTO"
        que  := posBE ? "El stop ya está en la entrada (sin riesgo). Deja correr hasta el objetivo." : "Mantén la operación. No muevas el Stop ni el Objetivo."
        cEst := cOppRojo
        vE   := posEnt
        vS   := posSL
        vT   := posTP
    else if armL and sesgoL
        est  := "⏳ POSIBLE LONG"
        que  := "El precio está en la zona de compra. TODAVÍA NO ENTRES: espera la señal de confirmación."
        cEst := cOppAmbar
    else if armS and sesgoS
        est  := "⏳ POSIBLE SHORT"
        que  := "El precio está en la zona de venta. TODAVÍA NO ENTRES: espera la señal de confirmación."
        cEst := cOppAmbar
    else if armL or armS
        est  := "⚠ ZONA TOCADA, CONTRA TENDENCIA"
        que  := "El precio tocó una zona, pero va en contra de la tendencia de " + htfN + ". No operar."
        cEst := cOppGris
    else
        est  := "⚪ SIN OPORTUNIDAD"
        que  := "No hagas nada. Espera a que el precio llegue a una zona de compra o de venta."
        cEst := cOppGris

    string tend = hTrend == 1 ? "Alcista → buscar solo LONG" : hTrend == -1 ? "Bajista → buscar solo SHORT" : "Sin dirección clara"
    if not usarSesgo
        tend := tend + " (filtro desactivado)"
    string zc = na(zcB) ? "Ninguna activa" : f_px(zcB) + " – " + f_px(zcT)
    string zv = na(zvB) ? "Ninguna activa" : f_px(zvB) + " – " + f_px(zvT)
    string av = not na(avisoBar) and bar_index - avisoBar <= 8 ? aviso : "—"
    string rb = na(vE) or na(vS) or na(vT) or vE == vS ? "—" : "1 : " + str.tostring(math.abs(vT - vE) / math.abs(vE - vS), "#.#")

    table.cell(opp, 0, 0, "¿HAY OPORTUNIDAD?", text_color = cOppTexto, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 1, 0, syminfo.ticker + " · " + (timeframe.isminutes ? timeframe.period + "m" : timeframe.period), text_color = cOppTexto, text_size = oppTam, text_halign = text.align_right)
    table.cell(opp, 0, 1, "Estado", text_color = cOppTexto, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 1, 1, est, text_color = color.white, bgcolor = cEst, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 0, 2, "Qué hacer", text_color = cOppTexto, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 1, 2, que, text_color = cOppTexto, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 0, 3, "Tendencia " + htfN, text_color = cOppTexto, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 1, 3, tend, text_color = hTrend == 1 ? cOppVerde : hTrend == -1 ? cOppRojo : cOppTexto, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 0, 4, "Zona de compra", text_color = cOppTexto, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 1, 4, zc, text_color = cOppVerde, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 0, 5, "Zona de venta", text_color = cOppTexto, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 1, 5, zv, text_color = cOppRojo, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 0, 6, "Entrada", text_color = cOppTexto, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 1, 6, f_px(vE), text_color = cOppTexto, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 0, 7, "Stop (SL)", text_color = cOppTexto, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 1, 7, f_px(vS), text_color = cOppRojo, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 0, 8, "Objetivo (TP)", text_color = cOppTexto, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 1, 8, f_px(vT) + (rb == "—" ? "" : "   (riesgo : beneficio " + rb + ")"), text_color = cOppVerde, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 0, 9, "Aviso", text_color = cOppTexto, text_size = oppTam, text_halign = text.align_left)
    table.cell(opp, 1, 9, av, text_color = cOppTexto, text_size = oppTam, text_halign = text.align_left)
