//@version=6
indicator("SMC Pro · Estructura, Liquidez, OB e Ineficiencias", shorttitle = "SMC Pro", overlay = true, max_boxes_count = 500, max_lines_count = 500, max_labels_count = 500, max_bars_back = 500)

// =====================================================================
// SMC Pro (indicador)
// Modelo: sesgo y Order Blocks en temporalidad superior (4H por defecto)
//         + confirmación por CHoCH en el gráfico (15m) tras tocar el 50% del OB.
// Reglas de mitigación: una zona se invalida SOLO cuando una vela CIERRA
// al otro lado (OB alcista / FVG alcista: cierre por debajo del mínimo).
// Order Block válido = última vela opuesta (rango completo con mechas) antes
// de un desplazamiento que rompe estructura (BOS/CHoCH), que además:
//   1) dejó al menos un FVG en el desplazamiento, y
//   2) tomó liquidez (un swing previo) dentro del mismo tramo.
// =====================================================================

// ---------------------------------------------------------------------
// 1. ENTRADAS
// ---------------------------------------------------------------------
const string G_HTF = "Temporalidad superior (sesgo y OB)"
const string G_EST = "Estructura (gráfico)"
const string G_OB  = "Order Blocks"
const string G_FVG = "Ineficiencias (FVG)"
const string G_LIQ = "Liquidez"
const string G_SET = "Modelo de entrada"
const string G_COL = "Colores (paleta oscura)"

htfTf      = input.timeframe("240", "Temporalidad superior", group = G_HTF)
htfLen     = input.int(5, "Longitud de pivote TF superior", minval = 2, maxval = 50, group = G_HTF, tooltip = "Velas a cada lado para confirmar un swing en la temporalidad superior. En 4H, 5 = el swing se confirma 20 horas después.")
showHtfOB  = input.bool(true, "Mostrar OB de la temporalidad superior", group = G_HTF)

intLen     = input.int(5, "Longitud de pivote (estructura interna)", minval = 2, maxval = 50, group = G_EST, tooltip = "Velas a cada lado para confirmar un swing en el gráfico. En 15m, 5 = el swing se confirma 75 minutos después.")
showEstr   = input.bool(true, "Mostrar BOS / CHoCH", group = G_EST)

showOB     = input.bool(true, "Mostrar OB del gráfico", group = G_OB)
reqSweep   = input.bool(true, "Exigir toma de liquidez previa", group = G_OB)
reqFvg     = input.bool(true, "Exigir FVG en el desplazamiento", group = G_OB)
maxOB      = input.int(5, "Máx. OB activos por dirección", minval = 1, maxval = 30, group = G_OB)
scanMax    = input.int(100, "Velas máximas a escanear para buscar el OB", minval = 10, maxval = 300, group = G_OB)

showFVG    = input.bool(true, "Mostrar FVG", group = G_FVG)
fvgMinAtr  = input.float(0.25, "Tamaño mínimo del FVG (× ATR 14)", minval = 0.0, step = 0.05, group = G_FVG, tooltip = "Filtra huecos insignificantes. 0 = sin filtro.")
fvgShrink  = input.bool(true, "Recortar FVG al rellenarse parcialmente", group = G_FVG)
maxFVG     = input.int(10, "Máx. FVG activos por dirección", minval = 1, maxval = 50, group = G_FVG)

showLiq    = input.bool(true, "Mostrar EQH / EQL y barridos", group = G_LIQ)
eqTol      = input.float(0.1, "Tolerancia EQH / EQL (× ATR 14)", minval = 0.01, step = 0.01, group = G_LIQ)

borrarMit  = input.bool(false, "Borrar zonas mitigadas (si no, quedan en gris)", group = G_SET)
showSig    = input.bool(true, "Mostrar señales de entrada", group = G_SET)
usarSesgo  = input.bool(true, "Operar solo a favor del sesgo de la TF superior", group = G_SET)
soloChoch  = input.bool(true, "Confirmación solo con CHoCH (si no, también BOS)", group = G_SET)
maxEspera  = input.int(48, "Velas máximas entre toque del 50% y confirmación", minval = 1, group = G_SET, tooltip = "En 15m, 48 velas = 12 horas.")
slBuf      = input.float(0.2, "Margen del stop detrás del OB (× ATR 14)", minval = 0.0, step = 0.05, group = G_SET)
rr         = input.float(3.0, "Relación R:B objetivo", minval = 1.0, step = 0.5, group = G_SET)
minRR      = input.float(2.0, "R:B mínimo para aceptar la operación", minval = 0.5, step = 0.5, group = G_SET)
modoTP     = input.string("Más conservador", "Objetivo (TP)", options = ["3R fijo", "Siguiente liquidez", "Más conservador"], group = G_SET, tooltip = "3R fijo: TP = entrada + R × riesgo.\nSiguiente liquidez: el swing no tomado más cercano que cumpla el R:B mínimo (si no hay, usa 3R).\nMás conservador: el más cercano entre 3R y esa liquidez.")
apal       = input.int(5, "Apalancamiento", minval = 1, maxval = 10, group = G_SET)
showPanel  = input.bool(true, "Mostrar panel", group = G_SET)

colObBull  = input.color(#0E5E4E, "OB alcista", group = G_COL)
colObBear  = input.color(#7A1F2B, "OB bajista", group = G_COL)
colHtfBull = input.color(#14532D, "OB TF superior alcista", group = G_COL)
colHtfBear = input.color(#5B1A1A, "OB TF superior bajista", group = G_COL)
colFvgBull = input.color(#1E3A5F, "FVG alcista", group = G_COL)
colFvgBear = input.color(#4A2C5E, "FVG bajista", group = G_COL)
colEstBull = input.color(#2E7D6B, "Estructura alcista", group = G_COL)
colEstBear = input.color(#9C3D4A, "Estructura bajista", group = G_COL)
colLiq     = input.color(#8D6E1F, "Liquidez", group = G_COL)
colMit     = input.color(#2A2E39, "Zona mitigada", group = G_COL)
colTxt     = input.color(#B2B5BE, "Texto", group = G_COL)

// ---------------------------------------------------------------------
// 2. MOTOR SMC (estructura, liquidez y Order Blocks)
//    Se usa en el gráfico y dentro de request.security para la TF superior.
// ---------------------------------------------------------------------
f_smc(simple int len, bool needSweep, bool needFvg, simple int maxScan, float tol, array<float> hP, array<int> hI, array<float> lP, array<int> lI) =>
    var int   trend   = 0
    var float swHi    = na
    var int   swHiIdx = na
    var bool  swHiOn  = false
    var float swLo    = na
    var int   swLoIdx = na
    var bool  swLoOn  = false
    var int   bslIdx  = na
    var int   sslIdx  = na
    var float bTop    = na
    var float bBot    = na
    var int   bIdx    = na
    var int   bTime   = na
    var float sTop    = na
    var float sBot    = na
    var int   sIdx    = na
    var int   sTime   = na

    float atr = ta.atr(14)
    float ph  = ta.pivothigh(high, len, len)
    float pl  = ta.pivotlow(low, len, len)

    int   evt     = 0
    float evtLvl  = na
    int   evtFrom = na
    bool  bNew    = false
    bool  sNew    = false
    bool  bslSw   = false
    float bslLvl  = na
    int   bslFrom = na
    bool  sslSw   = false
    float sslLvl  = na
    int   sslFrom = na
    float eqhLvl  = na
    int   eqhFrom = na
    float eqlLvl  = na
    int   eqlFrom = na

    // --- Liquidez tomada: swings no tomados que el precio supera ---
    int nH = array.size(hP)
    if nH > 0
        for k = nH - 1 to 0
            float p = array.get(hP, k)
            if high > p
                bslIdx := bar_index
                if na(bslLvl) or p > bslLvl
                    bslLvl  := p
                    bslFrom := array.get(hI, k)
                array.remove(hP, k)
                array.remove(hI, k)
    // Barrido = la mecha toma el nivel pero la vela cierra de vuelta
    bslSw := not na(bslLvl) and close < bslLvl

    int nL = array.size(lP)
    if nL > 0
        for k = nL - 1 to 0
            float p = array.get(lP, k)
            if low < p
                sslIdx := bar_index
                if na(sslLvl) or p < sslLvl
                    sslLvl  := p
                    sslFrom := array.get(lI, k)
                array.remove(lP, k)
                array.remove(lI, k)
    sslSw := not na(sslLvl) and close > sslLvl

    // --- Nuevos swings confirmados → pools de liquidez + EQH / EQL ---
    if not na(ph)
        int pIdx = bar_index - len
        int n = array.size(hP)
        if n > 0
            for k = 0 to n - 1
                if math.abs(ph - array.get(hP, k)) <= atr * tol
                    eqhLvl  := ph
                    eqhFrom := array.get(hI, k)
        array.push(hP, ph)
        array.push(hI, pIdx)
        if array.size(hP) > 40
            array.shift(hP)
            array.shift(hI)
        swHi    := ph
        swHiIdx := pIdx
        swHiOn  := true

    if not na(pl)
        int pIdx = bar_index - len
        int n = array.size(lP)
        if n > 0
            for k = 0 to n - 1
                if math.abs(pl - array.get(lP, k)) <= atr * tol
                    eqlLvl  := pl
                    eqlFrom := array.get(lI, k)
        array.push(lP, pl)
        array.push(lI, pIdx)
        if array.size(lP) > 40
            array.shift(lP)
            array.shift(lI)
        swLo    := pl
        swLoIdx := pIdx
        swLoOn  := true

    // --- Mitigación del OB activo: cierre al otro lado ---
    if not na(bBot) and close < bBot
        bTop  := na
        bBot  := na
        bIdx  := na
        bTime := na
    if not na(sTop) and close > sTop
        sTop  := na
        sBot  := na
        sIdx  := na
        sTime := na

    // --- Ruptura alcista (BOS / CHoCH) por cierre ---
    if swHiOn and close > swHi
        evt     := trend < 0 ? 2 : 1
        evtLvl  := swHi
        evtFrom := swHiIdx
        trend   := 1
        swHiOn  := false
        int   span = math.min(bar_index - swHiIdx, maxScan)
        float cT   = na
        float cB   = na
        int   cOff = na
        // Última vela bajista del tramo (la de mínimo más bajo = origen del impulso)
        for i = 1 to span
            if close[i] < open[i] and (na(cB) or low[i] < cB)
                cB   := low[i]
                cT   := high[i]
                cOff := i
        if not na(cOff)
            bool fvgOk = false
            if cOff >= 2
                for j = 0 to cOff - 2
                    if low[j] > high[j + 2]
                        fvgOk := true
                        break
            bool sweepOk = not na(sslIdx) and sslIdx >= swHiIdx
            if (not needFvg or fvgOk) and (not needSweep or sweepOk)
                bTop  := cT
                bBot  := cB
                bIdx  := bar_index - cOff
                bTime := time[cOff]
                bNew  := true

    // --- Ruptura bajista (BOS / CHoCH) por cierre ---
    if swLoOn and close < swLo
        evt     := trend > 0 ? -2 : -1
        evtLvl  := swLo
        evtFrom := swLoIdx
        trend   := -1
        swLoOn  := false
        int   span = math.min(bar_index - swLoIdx, maxScan)
        float cT   = na
        float cB   = na
        int   cOff = na
        for i = 1 to span
            if close[i] > open[i] and (na(cT) or high[i] > cT)
                cT   := high[i]
                cB   := low[i]
                cOff := i
        if not na(cOff)
            bool fvgOk = false
            if cOff >= 2
                for j = 0 to cOff - 2
                    if high[j] < low[j + 2]
                        fvgOk := true
                        break
            bool sweepOk = not na(bslIdx) and bslIdx >= swLoIdx
            if (not needFvg or fvgOk) and (not needSweep or sweepOk)
                sTop  := cT
                sBot  := cB
                sIdx  := bar_index - cOff
                sTime := time[cOff]
                sNew  := true

    [trend, evt, evtLvl, evtFrom, bNew, bTop, bBot, bIdx, bTime, sNew, sTop, sBot, sIdx, sTime, bslSw, bslLvl, bslFrom, sslSw, sslLvl, sslFrom, eqhLvl, eqhFrom, eqlLvl, eqlFrom, atr]

// Envoltorio para la TF superior: devuelve la vela HTF ya CERRADA (sin repintado)
f_htf(simple int len, bool needSweep, bool needFvg, simple int maxScan, float tol) =>
    var array<float> hp = array.new<float>()
    var array<int>   hx = array.new<int>()
    var array<float> lp = array.new<float>()
    var array<int>   lx = array.new<int>()
    [t, e, el, ef, bn, bt, bb, bi, btm, sn, st, sb, si, stm, x1, x2, x3, x4, x5, x6, x7, x8, x9, x10, a] = f_smc(len, needSweep, needFvg, maxScan, tol, hp, hx, lp, lx)
    [t[1], bt[1], bb[1], btm[1], st[1], sb[1], stm[1]]

// Liquidez objetivo: swing no tomado más cercano más allá de un umbral
f_liq(array<float> pool, float thr, bool up) =>
    float best = na
    int n = array.size(pool)
    if n > 0 and not na(thr)
        for k = 0 to n - 1
            float p = array.get(pool, k)
            if up and p >= thr and (na(best) or p < best)
                best := p
            if not up and p <= thr and (na(best) or p > best)
                best := p
    best

f_trendTxt(int t) =>
    t == 1 ? "Alcista ▲" : t == -1 ? "Bajista ▼" : "Neutral"

// ---------------------------------------------------------------------
// 3. CÁLCULOS
// ---------------------------------------------------------------------
var array<float> lqHiP = array.new<float>()
var array<int>   lqHiI = array.new<int>()
var array<float> lqLoP = array.new<float>()
var array<int>   lqLoI = array.new<int>()

[trend, evt, evtLvl, evtFrom, bNew, bTop, bBot, bIdx, bTime, sNew, sTop, sBot, sIdx, sTime, bslSw, bslLvl, bslFrom, sslSw, sslLvl, sslFrom, eqhLvl, eqhFrom, eqlLvl, eqlFrom, atrL] = f_smc(intLen, reqSweep, reqFvg, scanMax, eqTol, lqHiP, lqHiI, lqLoP, lqLoI)

[hTrend, hBT, hBB, hBTm, hST, hSB, hSTm] = request.security(syminfo.tickerid, htfTf, f_htf(htfLen, reqSweep, reqFvg, scanMax, eqTol), lookahead = barmerge.lookahead_on)

float hBMid = (hBT + hBB) / 2
float hSMid = (hST + hSB) / 2
bool  tfOk  = timeframe.in_seconds() < timeframe.in_seconds(htfTf)
int   tfMs  = timeframe.in_seconds() * 1000

// ---------------------------------------------------------------------
// 4. DIBUJO: zonas (OB y FVG) con mitigación por cierre
// ---------------------------------------------------------------------
type Zona
    box   caja
    line  mid
    float top
    float bot
    int   dir

f_actualizar(array<Zona> zs, bool shrink, bool borrar, color cMit) =>
    int n = array.size(zs)
    if n > 0
        for k = n - 1 to 0
            Zona z = array.get(zs, k)
            bool mit = z.dir == 1 ? close < z.bot : close > z.top
            if mit
                if borrar
                    box.delete(z.caja)
                    line.delete(z.mid)
                else
                    box.set_right(z.caja, bar_index)
                    box.set_bgcolor(z.caja, color.new(cMit, 60))
                    box.set_border_color(z.caja, cMit)
                    box.set_text_color(z.caja, color.new(cMit, 0))
                    line.set_x2(z.mid, bar_index)
                    line.set_color(z.mid, cMit)
                array.remove(zs, k)
            else
                if shrink
                    if z.dir == 1 and low < z.top
                        z.top := math.max(low, z.bot)
                        box.set_top(z.caja, z.top)
                    if z.dir == -1 and high > z.bot
                        z.bot := math.min(high, z.top)
                        box.set_bottom(z.caja, z.bot)
                box.set_right(z.caja, bar_index + 5)
                line.set_x2(z.mid, bar_index + 5)
    true

f_nueva(array<Zona> zs, int left, float top, float bot, int dir, color c, string txt, int maxN, color cTxt) =>
    float m = (top + bot) / 2
    box  b = box.new(left, top, bar_index + 5, bot, bgcolor = color.new(c, 55), border_color = color.new(c, 20), text = txt, text_size = size.tiny, text_color = cTxt, text_halign = text.align_right, text_valign = text.align_center)
    line l = line.new(left, m, bar_index + 5, m, color = color.new(c, 0), style = line.style_dotted, width = 1)
    array.push(zs, Zona.new(b, l, top, bot, dir))
    if array.size(zs) > maxN
        Zona old = array.shift(zs)
        box.delete(old.caja)
        line.delete(old.mid)
    true

var array<Zona> obBull  = array.new<Zona>()
var array<Zona> obBear  = array.new<Zona>()
var array<Zona> fvgBull = array.new<Zona>()
var array<Zona> fvgBear = array.new<Zona>()

f_actualizar(obBull, false, borrarMit, colMit)
f_actualizar(obBear, false, borrarMit, colMit)
f_actualizar(fvgBull, fvgShrink, borrarMit, colMit)
f_actualizar(fvgBear, fvgShrink, borrarMit, colMit)

// OB del gráfico
if showOB and bNew
    f_nueva(obBull, bIdx, bTop, bBot, 1, colObBull, "OB", maxOB, colTxt)
if showOB and sNew
    f_nueva(obBear, sIdx, sTop, sBot, -1, colObBear, "OB", maxOB, colTxt)

// FVG del gráfico (patrón de 3 velas, filtrado por tamaño)
bool fvgUp = low > high[2] and (low - high[2]) >= atrL * fvgMinAtr
bool fvgDn = high < low[2] and (low[2] - high) >= atrL * fvgMinAtr
if showFVG and fvgUp
    f_nueva(fvgBull, bar_index - 2, low, high[2], 1, colFvgBull, "FVG", maxFVG, colTxt)
if showFVG and fvgDn
    f_nueva(fvgBear, bar_index - 2, low[2], high, -1, colFvgBear, "FVG", maxFVG, colTxt)

// Estructura
if showEstr and evt != 0
    bool  up    = evt > 0
    bool  choch = math.abs(evt) == 2
    color c     = up ? colEstBull : colEstBear
    line.new(evtFrom, evtLvl, bar_index, evtLvl, color = c, style = choch ? line.style_solid : line.style_dashed, width = 1)
    label.new(int(math.round((evtFrom + bar_index) / 2)), evtLvl, choch ? "CHoCH" : "BOS", color = color.new(color.black, 100), textcolor = c, style = up ? label.style_label_down : label.style_label_up, size = size.tiny)

// Liquidez: EQH / EQL y barridos
if showLiq and not na(eqhLvl)
    line.new(eqhFrom, eqhLvl, bar_index - intLen, eqhLvl, color = colLiq, style = line.style_dotted, width = 1)
    label.new(bar_index - intLen, eqhLvl, "EQH", color = color.new(color.black, 100), textcolor = colLiq, style = label.style_label_down, size = size.tiny)
if showLiq and not na(eqlLvl)
    line.new(eqlFrom, eqlLvl, bar_index - intLen, eqlLvl, color = colLiq, style = line.style_dotted, width = 1)
    label.new(bar_index - intLen, eqlLvl, "EQL", color = color.new(color.black, 100), textcolor = colLiq, style = label.style_label_up, size = size.tiny)
if showLiq and bslSw
    line.new(bslFrom, bslLvl, bar_index, bslLvl, color = colLiq, style = line.style_dashed, width = 1)
    label.new(bar_index, bslLvl, "✕ BSL", color = color.new(color.black, 100), textcolor = colLiq, style = label.style_label_down, size = size.tiny)
if showLiq and sslSw
    line.new(sslFrom, sslLvl, bar_index, sslLvl, color = colLiq, style = line.style_dashed, width = 1)
    label.new(bar_index, sslLvl, "✕ SSL", color = color.new(color.black, 100), textcolor = colLiq, style = label.style_label_up, size = size.tiny)

// OB de la temporalidad superior (solo el más reciente válido por dirección)
string htfName = htfTf == "240" ? "4H" : htfTf
var box  hBullBox = na
var line hBullLn  = na
var box  hBearBox = na
var line hBearLn  = na

bool hBullChg = (na(hBTm) != na(hBTm[1])) or (not na(hBTm) and hBTm != hBTm[1])
bool hBearChg = (na(hSTm) != na(hSTm[1])) or (not na(hSTm) and hSTm != hSTm[1])

if showHtfOB and hBullChg
    if not na(hBullBox)
        box.set_right(hBullBox, time)
        box.set_bgcolor(hBullBox, color.new(colMit, 60))
        box.set_border_color(hBullBox, colMit)
        line.set_x2(hBullLn, time)
        line.set_color(hBullLn, colMit)
        hBullBox := na
        hBullLn  := na
    if not na(hBTm)
        hBullBox := box.new(hBTm, hBT, time + 5 * tfMs, hBB, xloc = xloc.bar_time, bgcolor = color.new(colHtfBull, 60), border_color = colHtfBull, border_width = 2, text = "OB " + htfName, text_size = size.small, text_color = colTxt, text_halign = text.align_left, text_valign = text.align_top)
        hBullLn  := line.new(hBTm, hBMid, time + 5 * tfMs, hBMid, xloc = xloc.bar_time, color = colTxt, style = line.style_dashed, width = 1)
if showHtfOB and not na(hBullBox)
    box.set_right(hBullBox, time + 5 * tfMs)
    line.set_x2(hBullLn, time + 5 * tfMs)

if showHtfOB and hBearChg
    if not na(hBearBox)
        box.set_right(hBearBox, time)
        box.set_bgcolor(hBearBox, color.new(colMit, 60))
        box.set_border_color(hBearBox, colMit)
        line.set_x2(hBearLn, time)
        line.set_color(hBearLn, colMit)
        hBearBox := na
        hBearLn  := na
    if not na(hSTm)
        hBearBox := box.new(hSTm, hST, time + 5 * tfMs, hSB, xloc = xloc.bar_time, bgcolor = color.new(colHtfBear, 60), border_color = colHtfBear, border_width = 2, text = "OB " + htfName, text_size = size.small, text_color = colTxt, text_halign = text.align_left, text_valign = text.align_bottom)
        hBearLn  := line.new(hSTm, hSMid, time + 5 * tfMs, hSMid, xloc = xloc.bar_time, color = colTxt, style = line.style_dashed, width = 1)
if showHtfOB and not na(hBearBox)
    box.set_right(hBearBox, time + 5 * tfMs)
    line.set_x2(hBearLn, time + 5 * tfMs)

// ---------------------------------------------------------------------
// 5. MODELO DE ENTRADA
//    1) Precio toca el 50% del OB de la TF superior sin cerrar al otro lado → ARMADO
//    2) En ≤ maxEspera velas aparece CHoCH a favor en el gráfico → SEÑAL
//    3) SL detrás del OB (+ margen ATR); TP según modo; filtro R:B y de liquidación
// ---------------------------------------------------------------------
var bool armL    = false
var int  armLBar = na
var int  armLOb  = na
var int  usedLOb = na
var bool armS    = false
var int  armSBar = na
var int  armSOb  = na
var int  usedSOb = na

if armL and (na(hBTm) or hBTm != armLOb or close < hBB or bar_index - armLBar > maxEspera)
    armL := false
if armS and (na(hSTm) or hSTm != armSOb or close > hST or bar_index - armSBar > maxEspera)
    armS := false

bool toqueL = not na(hBTm) and (na(usedLOb) or hBTm != usedLOb) and low <= hBMid and close >= hBB
bool toqueS = not na(hSTm) and (na(usedSOb) or hSTm != usedSOb) and high >= hSMid and close <= hST

if not armL and toqueL
    armL    := true
    armLBar := bar_index
    armLOb  := hBTm
if not armS and toqueS
    armS    := true
    armSBar := bar_index
    armSOb  := hSTm

bool confL  = soloChoch ? evt == 2 : evt > 0
bool confS  = soloChoch ? evt == -2 : evt < 0
bool sesgoL = not usarSesgo or hTrend == 1
bool sesgoS = not usarSesgo or hTrend == -1

float slL   = hBB - atrL * slBuf
float riskL = close - slL
float tpL3  = close + rr * riskL
float liqL  = f_liq(lqHiP, close + minRR * riskL, true)
float tpL   = modoTP == "3R fijo" ? tpL3 : na(liqL) ? tpL3 : modoTP == "Siguiente liquidez" ? liqL : math.min(tpL3, liqL)

float slS   = hST + atrL * slBuf
float riskS = slS - close
float tpS3  = close - rr * riskS
float liqS  = f_liq(lqLoP, close - minRR * riskS, false)
float tpS   = modoTP == "3R fijo" ? tpS3 : na(liqS) ? tpS3 : modoTP == "Siguiente liquidez" ? liqS : math.max(tpS3, liqS)

// Filtro de liquidación (aproximado): el stop debe estar bastante antes del precio de liquidación
float liqDist = 100.0 / apal * 0.8
bool okL = riskL > 0 and (tpL - close) / riskL >= minRR and riskL / close * 100 < liqDist
bool okS = riskS > 0 and (close - tpS) / riskS >= minRR and riskS / close * 100 < liqDist

bool senalL = tfOk and armL and confL and sesgoL and okL
bool senalS = tfOk and armS and confS and sesgoS and okS

if senalL
    usedLOb := armLOb
    armL    := false
if senalS
    usedSOb := armSOb
    armS    := false

if showSig and senalL
    label.new(bar_index, low, "COMPRA\nSL " + str.tostring(slL, format.mintick) + "\nTP " + str.tostring(tpL, format.mintick) + "\nR:B " + str.tostring((tpL - close) / riskL, "#.##"), yloc = yloc.belowbar, style = label.style_label_up, color = colObBull, textcolor = color.white, size = size.small)
    line.new(bar_index, slL, bar_index + 20, slL, color = colEstBear, width = 1)
    line.new(bar_index, tpL, bar_index + 20, tpL, color = colEstBull, width = 1)
    alert("SMC Pro · COMPRA " + syminfo.ticker + " | Entrada " + str.tostring(close, format.mintick) + " | SL " + str.tostring(slL, format.mintick) + " | TP " + str.tostring(tpL, format.mintick), alert.freq_once_per_bar_close)
if showSig and senalS
    label.new(bar_index, high, "VENTA\nSL " + str.tostring(slS, format.mintick) + "\nTP " + str.tostring(tpS, format.mintick) + "\nR:B " + str.tostring((close - tpS) / riskS, "#.##"), yloc = yloc.abovebar, style = label.style_label_down, color = colObBear, textcolor = color.white, size = size.small)
    line.new(bar_index, slS, bar_index + 20, slS, color = colEstBear, width = 1)
    line.new(bar_index, tpS, bar_index + 20, tpS, color = colEstBull, width = 1)
    alert("SMC Pro · VENTA " + syminfo.ticker + " | Entrada " + str.tostring(close, format.mintick) + " | SL " + str.tostring(slS, format.mintick) + " | TP " + str.tostring(tpS, format.mintick), alert.freq_once_per_bar_close)

// ---------------------------------------------------------------------
// 6. ALERTAS (crear en TradingView: "Cualquier llamada de alert()" o las de abajo)
// ---------------------------------------------------------------------
alertcondition(senalL, "Señal de COMPRA", "SMC Pro: señal de COMPRA en {{ticker}} ({{interval}})")
alertcondition(senalS, "Señal de VENTA", "SMC Pro: señal de VENTA en {{ticker}} ({{interval}})")
alertcondition(toqueL and not armL[1], "Toque 50% OB alcista TF superior", "SMC Pro: precio en el 50% del OB alcista en {{ticker}}")
alertcondition(toqueS and not armS[1], "Toque 50% OB bajista TF superior", "SMC Pro: precio en el 50% del OB bajista en {{ticker}}")
alertcondition(evt == 2, "CHoCH alcista", "SMC Pro: CHoCH alcista en {{ticker}} ({{interval}})")
alertcondition(evt == -2, "CHoCH bajista", "SMC Pro: CHoCH bajista en {{ticker}} ({{interval}})")
alertcondition(bslSw or sslSw, "Barrido de liquidez", "SMC Pro: barrido de liquidez en {{ticker}} ({{interval}})")

// ---------------------------------------------------------------------
// 7. PANEL
// ---------------------------------------------------------------------
var table tb = table.new(position.top_right, 2, 6, bgcolor = #131722, border_color = #2A2E39, border_width = 1, frame_color = #2A2E39, frame_width = 1)
if showPanel and barstate.islast
    string estado = armL ? "ARMADO LARGO · esperando CHoCH" : armS ? "ARMADO CORTO · esperando CHoCH" : "Esperando toque del 50%"
    table.cell(tb, 0, 0, "SMC Pro", text_color = colTxt, text_size = size.small)
    table.cell(tb, 1, 0, tfOk ? "" : "⚠ Usa un TF menor que " + htfName, text_color = colEstBear, text_size = size.small)
    table.cell(tb, 0, 1, "Sesgo " + htfName, text_color = colTxt, text_size = size.small)
    table.cell(tb, 1, 1, f_trendTxt(hTrend), text_color = hTrend == 1 ? colEstBull : hTrend == -1 ? colEstBear : colTxt, text_size = size.small)
    table.cell(tb, 0, 2, "Estructura " + timeframe.period, text_color = colTxt, text_size = size.small)
    table.cell(tb, 1, 2, f_trendTxt(trend), text_color = trend == 1 ? colEstBull : trend == -1 ? colEstBear : colTxt, text_size = size.small)
    table.cell(tb, 0, 3, "OB " + htfName + " alcista", text_color = colTxt, text_size = size.small)
    table.cell(tb, 1, 3, na(hBB) ? "—" : str.tostring(hBB, format.mintick) + " – " + str.tostring(hBT, format.mintick), text_color = colTxt, text_size = size.small)
    table.cell(tb, 0, 4, "OB " + htfName + " bajista", text_color = colTxt, text_size = size.small)
    table.cell(tb, 1, 4, na(hSB) ? "—" : str.tostring(hSB, format.mintick) + " – " + str.tostring(hST, format.mintick), text_color = colTxt, text_size = size.small)
    table.cell(tb, 0, 5, "Estado", text_color = colTxt, text_size = size.small)
    table.cell(tb, 1, 5, estado, text_color = colLiq, text_size = size.small)
